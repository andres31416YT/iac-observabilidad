          "expr": "cpu_load_percent",
          "refId": "A"
        }]
      },
      {
        "type": "logs",
        "title": "API Logs (api-rust)",
        "gridPos": {"x": 0, "y": 4, "w": 12, "h": 8},
        "targets": [{
          "expr": "{service=\"api-rust\"}",
          "refId": "A"
        }]
      }
    ]
  },
  "overwrite": true
}